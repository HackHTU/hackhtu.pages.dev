# =============================================================================
# Hack HTU 环境变量示例
#
# 本地开发：
#   cp .env.example .env
#   然后填入真实值。.env 已被 .gitignore 忽略，不要提交。
#
# 这个文件放在仓库根目录，所有 workspace 的 dev 都读取它：
#   - wrangler pages dev（Pages Functions）
#   - Vite（envDir 指向仓库根目录）
#   - apps/bot 脚本（--env-file ../../.env）
#
# 生产环境：
#   Cloudflare Pages → Settings → Variables and Secrets 逐项配置。
#   带 SECRET / TOKEN / KEY 的变量请使用 Encrypted 类型。
# =============================================================================

# -----------------------------------------------------------------------------
# 前端（Vite，会被打包进浏览器代码，不能放任何密钥）
# -----------------------------------------------------------------------------
# Turnstile 站点 key，可公开。
# 和其他变量一起放在仓库根目录的 .env 即可（Vite 的 envDir 已指向根目录）。
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# -----------------------------------------------------------------------------
# Cloudflare Turnstile（Pages Functions 校验用，必须保密）
# -----------------------------------------------------------------------------
# Turnstile widget 的 secret key（下面是 Cloudflare 官方测试 key，始终校验通过）
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# 允许的站点 hostname，逗号分隔，不要带协议和路径
TURNSTILE_HOSTNAMES=localhost,127.0.0.1,hackhtu.pages.dev,www.hackhtu.pages.dev

# -----------------------------------------------------------------------------
# Telegram Bot 密钥（必须保密）
# -----------------------------------------------------------------------------
# BotFather 签发的 token（也用于站点事件通知的群消息）
BOT_TOKEN=1234567890:AAExampleExampleExampleExampleExample
# 同时用于 webhook 路径 /bot/webhook/<WEBHOOK_SECRET> 和
# X-Telegram-Bot-Api-Secret-Token 请求头，建议 32 位以上随机串，
# 且只能包含 A-Z a-z 0-9 _ -
WEBHOOK_SECRET=replace_with_a_long_random_string
# /bot/setup 与 /bot/cron/rss 的访问令牌
SETUP_TOKEN=replace_with_another_random_string

# -----------------------------------------------------------------------------
# Telegram Bot 行为配置（普通变量，可留空使用默认值）
# -----------------------------------------------------------------------------
# bot 用户名，用于生成私聊深链
BOT_USERNAME=hackHTUbot
# 允许响应的群组，可填群 ID、群标题或 @username，逗号分隔
ALLOWED_CHATS=@HackHTU,@HackHTUDEV
# RSS 源：k1=v1,k2=v2，值是订阅地址
RSS_FEEDS=教务通知=https://rss.htu.me/rss/htu/teaching/3251,公示公告=https://rss.htu.me/rss/htu/teaching/3258,考务管理=https://rss.htu.me/rss/htu/teaching/kwgl
# 通知目标：v1,v2,v3，可填数字群 ID 或 @username；RSS 推送和站点通知共用
NOTIFY_CHATS=-1001918752754,-1004957193457
# 关键词违规临时封禁时长（秒），默认 86400
BAN_DURATION_SECONDS=86400
# 新成员验证超时（秒），超时后作答会被移出群聊，默认 120
VERIFY_TIMEOUT_SECONDS=120

# -----------------------------------------------------------------------------
# Workers AI（AI 绑定在 wrangler.jsonc 中声明，这里只配置模型参数）
# -----------------------------------------------------------------------------
# 历史对话压缩触发阈值（token），默认 32000
AI_CONTEXT_TOKEN_LIMIT=32000
# 主对话模型（Pi AI 走 AI 绑定）
AI_MODEL=@cf/qwen/qwen3.8-27b
# 是否插话的判定模型（structured classifier）
AI_TRIAGE_MODEL=@cf/cloudflare/clef-flash
# 判定模型给出「该回复」的概率阈值，超过才主动插话，默认 0.5
AI_TRIAGE_THRESHOLD=0.5
# 长期记忆上限（字符），超长丢弃最旧的行，默认 4000
AI_MEMORY_LIMIT=4000
# reasoning 强度：low / medium / xhigh，默认 medium
AI_REASONING=medium
# 表情贴纸包名称（t.me/addstickers/<name>）
STICKER_SET=spv_3f97a3558a8c83338ff83621f0ab838b_by_stckrRobot
# 日志级别：debug / info / warn / error，默认 info；
# 排查「消息没发出去」时用 debug（会打印每次 Telegram API 调用）
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# 本地脚本（apps/bot/scripts，不参与 Pages 部署）
# -----------------------------------------------------------------------------
# bun run bot:webhook 默认把 webhook 指到哪个站点
BOT_URL=https://hackhtu.pages.dev
