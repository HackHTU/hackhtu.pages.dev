{
  "name": "hackhtu",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun run --parallel dev:web dev:api",
    "dev:web": "bun run --filter @hackhtu/web dev",
    "dev:api": "wrangler pages dev apps/web/public --local --port 8788 --env-file .env",
    "build": "bun run --filter @hackhtu/web build",
    "preview": "bun run build && wrangler pages dev apps/web/dist --local --port 8788",
    "predeploy": "bun apps/bot/scripts/predeploy.ts",
    "deploy": "bun run build && wrangler pages deploy apps/web/dist",
    "d1:local": "wrangler d1 execute HackHTUDB --local",
    "d1:migrate:local": "wrangler d1 migrations apply HackHTUDB --local",
    "d1:remote": "wrangler d1 execute HackHTUDB --remote",
    "db:generate": "bun run --filter @hackhtu/db generate",
    "bot:webhook": "bun run --filter @hackhtu/bot webhook",
    "bot:poll": "bun run --filter @hackhtu/bot poll",
    "bot:poll:local": "bun run --filter @hackhtu/bot poll:local",
    "dev:bot": "bun run --parallel dev:api bot:poll:local",
    "cf:typegen": "wrangler types",
    "typecheck": "tsc -b",
    "check": "bun run typecheck && ultracite check --max-warnings=500",
    "fix": "ultracite fix --max-warnings=500"
  },
  "dependencies": {
    "@hono/zod-validator": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@shadcn/lint": "catalog:",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-plugin-react-doctor": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "ultracite": "catalog:",
    "wrangler": "catalog:"
  },
  "catalog": {
    "@cloudflare/workers-types": "^5.20261029.1",
    "@hono/zod-validator": "^0.7.4",
    "@hookform/resolvers": "^5.2.2",
    "@phosphor-icons/react": "^2.1.10",
    "@shadcn/lint": "^0.2.3",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-query": "^5.90.5",
    "@tanstack/react-router": "^1.132.47",
    "@tanstack/react-table": "^8.21.3",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "@zumer/snapdom": "^3.6.0",
    "ai": "^7.0.157",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "date-fns": "^4.4.0",
    "drizzle-kit": "^0.31.6",
    "drizzle-orm": "^0.44.7",
    "grammy": "^1.46.0",
    "hono": "^4.11.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-plugin-react-doctor": "^0.9.18",
    "oxlint-tsgolint": "^7.0.2005",
    "pagemd": "0.0.1",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.65.0",
    "react-turnstile": "^1.1.5",
    "rss-parser": "^3.13.0",
    "tailwindcss": "^4.1.14",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "ultracite": "8.1.0",
    "vite": "^7.1.10",
    "vite-plugin-pwa": "^1.1.0",
    "wrangler": "^4.155.0",
    "workers-ai-provider": "^4.0.1",
    "zod": "^4.1.12",
    "@grammyjs/stream": "^1.1.0",
    "@ai-sdk/provider": "^4.0.34",
    "leaflet": "^1.9.4",
    "react-leaflet": "^5.0.0",
    "@types/leaflet": "^1.9.22",
    "supercluster": "^8.0.1",
    "@types/supercluster": "^7.1.0"
  }
}
